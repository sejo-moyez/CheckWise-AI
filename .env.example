# Never use development values for a public deployment.
DEBUG=true
DJANGO_SECRET_KEY=
BRAND_NAME=CheckWise AI
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:5173
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Omit DATABASE_URL for local SQLite, or use your private PostgreSQL URL.
DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=true
DETECTION_PROVIDER=mock
DETECTION_API_URL=
DETECTION_API_KEY=
REWRITE_PROVIDER=mock
REWRITE_API_URL=
REWRITE_API_KEY=
PAYMENT_PROVIDER=mock
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
REQUIRE_EMAIL_VERIFICATION=true
MAX_DOCUMENT_WORDS=30000
RETENTION_DAYS=90
EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
DEFAULT_FROM_EMAIL=CheckWise <no-reply@localhost>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
S3_BUCKET=
S3_ENDPOINT_URL=
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
