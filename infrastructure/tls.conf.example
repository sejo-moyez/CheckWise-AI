# Install in the host Nginx http context after obtaining valid TLS certificates.
limit_req_zone $binary_remote_addr zone=checkwise_auth:10m rate=10r/m;
log_format checkwise_private '$remote_addr $request_method $uri $status $body_bytes_sent';
server {
    listen 80;
    server_name checkwise.example.com;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name checkwise.example.com;
    ssl_certificate /etc/letsencrypt/live/checkwise.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/checkwise.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 21m;
    access_log /var/log/nginx/checkwise-access.log checkwise_private;
    location /api/v1/auth/ {
        limit_req zone=checkwise_auth burst=10 nodelay;
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
}
