DEBUG=false
DJANGO_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET
BRAND_NAME=CheckWise AI
ALLOWED_HOSTS=checkwise.example.com
FRONTEND_URL=https://checkwise.example.com
FRONTEND_ORIGINS=https://checkwise.example.com
SECURE_SSL_REDIRECT=true
POSTGRES_DB=checkwise
POSTGRES_USER=checkwise
POSTGRES_PASSWORD=REPLACE_WITH_A_DATABASE_SECRET
DATABASE_URL=postgres://checkwise:REPLACE_WITH_A_DATABASE_SECRET@db:5432/checkwise
REDIS_URL=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=false
DETECTION_PROVIDER=gateway
DETECTION_API_URL=
DETECTION_API_KEY=
REWRITE_PROVIDER=gateway
REWRITE_API_URL=
REWRITE_API_KEY=
PAYMENT_PROVIDER=mpesa
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://checkwise.example.com/api/v1/payments/mpesa/callback/
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=CheckWise <no-reply@checkwise.example.com>
RETENTION_DAYS=90
REQUIRE_EMAIL_VERIFICATION=true
# Optional: otherwise use private_media shared volume, never publicly served.
S3_BUCKET=
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
